{
  "name": "@trackflow/public-website",
  "version": "0.1.0",
  "private": true,
  "description": "TrackFlow public website (Milestone 1): static HTML, Tailwind CSS, and JavaScript form validation.",
  "scripts": {
    "start": "npx --yes http-server@14.1.1 . -p 3000 -a 0.0.0.0 -c-1",
    "build:css": "npx --yes @tailwindcss/cli@4.3.3 -i src/input.css -o tailwind.css --minify",
    "typecheck": "node --check validation.js",
    "test": "node --test tests/*.test.js",
    "build": "node --check validation.js"
  }
}
