# Direct local development. Docker Compose may instead use the same-origin
# /trackflow-api proxy configured at the repository root.
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# Temporary Phase 2 telemetry receiver. Components never hardcode this URL;
# TelemetryService batches all approved events here.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
NEXT_PUBLIC_APP_RELEASE=development
