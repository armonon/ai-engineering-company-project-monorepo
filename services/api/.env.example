# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# JWT signing secret. Required — the app refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_long_random_hex_string

# Session token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Password reset (AUTH-03)
# ---------------------------------------------------------------------------
# Transactional email provider: Resend (https://resend.com).
# Create a free account, then Dashboard -> API Keys -> Create API Key.
# WITHOUT this key the app still works: the reset link is printed to the
# server log instead of emailed, so the flow is testable locally.
RESEND_API_KEY=

# Sender address. Resend's shared onboarding sender needs no DNS setup
# and can deliver to the address that owns the Resend account.
# Use your own verified domain to send to arbitrary recipients.
EMAIL_FROM=TrackFlow <onboarding@resend.dev>

# Where the reset link points — the backoffice, not the API.
FRONTEND_BASE_URL=http://localhost:3100

# Reset-link lifetime, in minutes. Clamped to 5–120.
RESET_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# TINYDB_PATH=data/trackflow.json

# ---------------------------------------------------------------------------
# Inventory database — Supabase PostgreSQL (Milestone 5)
#
# The second of the service's two databases. TinyDB above keeps users and
# auth; this one holds SKUs and stock movements. Never commit the real
# value — .env is gitignored and this file is the template.
#
# From the Supabase dashboard: Connect -> Direct, method "Transaction
# pooler", type "URI". Paste that string here.
#
# Leaving it unset is safe: the API still boots and every TinyDB-backed
# route keeps working; only /inventory is unavailable, and startup logs
# a warning saying so.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
