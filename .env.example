# Copy to .env before the first `docker compose up --build`.
# Use a unique random value outside local development.
TOKEN_4GEEKS=replace_with_your_student_token
SECRET_KEY=local-development-only-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The browser uses a same-origin path. Next.js proxies that path to the backend
# service name inside the Compose network.
NEXT_PUBLIC_API_BASE_URL=/trackflow-api
# Assignment-specific backoffice override. Leave blank to use the general
# same-origin path above and its Docker service-name proxy.
NEXT_PUBLIC_INVENTORY_API_URL=
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/trackflow-api/telemetry/events
NEXT_PUBLIC_APP_RELEASE=development
FRONTEND_BASE_URL=http://localhost:3001
TRACKFLOW_API_INTERNAL_URL=http://backend:8000
TELEMETRY_ENDPOINT=http://backend:8000/telemetry/events
# Generate a separate random value; never commit the real key.
TELEMETRY_HMAC_KEY=replace_with_a_long_random_telemetry_hmac_key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SQLite makes the complete inventory flow work without a cloud account.
# Replace this with the private Supabase pooler URI when testing Supabase.
DATABASE_URL=sqlite:////workspace/services/api/data/inventory.db

# Shared broker and result backend for the API, worker, and Flower containers.
REDIS_URL=redis://redis:6379/0

# RAG knowledge base. Use a LiteLLM/OpenAI-compatible virtual key; never the
# student platform token. The two model IDs must remain different.
QDRANT_URL=http://qdrant:6333
LITELLM_BASE_URL=https://llm.4geeks.ai/v1
LITELLM_API_KEY=
EMBEDDING_MODEL=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b
GENERATION_MODEL=downtown-miami/groq/llama-3.1-8b-instant
RAG_MIN_SCORE=0.55

# Independent nightly export. Blank means the previous UTC calendar day.
TARGET_DATE=

# Optional: without a Resend key the API logs reset links locally.
RESEND_API_KEY=
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
