{
  "name": "@trackflow/programming-fundamentals",
  "version": "0.1.0",
  "private": true,
  "description": "TrackFlow programming-fundamentals module (Milestone 2) — Product, Shipment, Carrier, and InventoryMovement domain types with collection filters, searches, transformations, and validations.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test 'dist/tests/**/*.test.js'",
    "demo": "npm run build && node dist/src/demo.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3"
  }
}
